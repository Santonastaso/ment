# Supabase access token for CLI / GitHub Actions
# Rotate at https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Project identifiers and connection info
SUPABASE_PROJECT_REF=
SUPABASE_DB_URL=
SUPABASE_URL=https://YOUR_REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_ORIGIN=http://localhost:3000

# AI processing is server-side and fails closed when it is not configured.
#   supabase secrets set AI_PROCESSING_ENABLED=true MISTRAL_API=... MISTRAL_MODEL=ministral-3b-latest
AI_PROCESSING_ENABLED=false
MISTRAL_API=
MISTRAL_MODEL=ministral-3b-latest

# Optional calendar providers. Add only the providers approved for production.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
CALENDAR_TOKEN_ENCRYPTION_KEY=
