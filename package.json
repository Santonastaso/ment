{
  "name": "ment",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "npm ci --prefix client",
    "dev": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "test": "node --test scripts/*.test.mjs",
    "lint": "supabase db lint --linked",
    "deploy:functions": "supabase functions deploy",
    "check:i18n": "node scripts/check-i18n-coverage.mjs",
    "check:migrations": "node scripts/check-migrations.mjs"
  },
  "devDependencies": {
    "supabase": "^2.115.0"
  }
}
